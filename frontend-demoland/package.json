{
  "name": "@cryptosure/frontend-demoland",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3014",
    "dev:demo": "vite --mode demoland",
    "dev:real": "vite --mode realdeal",
