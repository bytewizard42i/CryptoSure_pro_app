# Public navigation destination only. This value is not a secret.
# The landing page normalizes this base to /tour and adds either
# ?audience=customer or ?audience=provider for the two guided entrances.
NEXT_PUBLIC_CRYPTOSURE_APP_URL=http://127.0.0.1:3014/tour

# A deployed landing page must use a reviewed HTTPS destination, for example:
# NEXT_PUBLIC_CRYPTOSURE_APP_URL=https://demo.cryptosure.pro/tour
